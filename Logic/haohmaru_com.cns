triggerall = power >= 1000
triggerall = statetype != A
trigger1 = ctrl
trigger2 = stateno = 200 || stateno = 400 || stateno = 230 && movecontact
trigger3 = (stateno = 240 && anim = 241) || (stateno = 250 && anim = 251) && movecontact
trigger4 = stateno = 430 || stateno = 440 && MoveContact
trigger5 = (stateno = 210 && anim = 211) || stateno = 410 || stateno = 420 || (stateno = 240) && movecontact
trigger6 = stateno = [1000,2999] && movecontact
trigger7 = stateno = 3000 && movecontact
trigger8 = stateno = 3031 && movecontact && animelemtime(8) < 0
