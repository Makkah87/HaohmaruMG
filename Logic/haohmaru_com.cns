[Command]
name = "D"
command = D
time = 1
;----------------------------------------------------------------------
; 2. State entry
;----------------------------------------------------------------------
[Statedef -1]
;======================================================================
;----------------------------------------------------------------------
;Tenha Fujin Zan Max
[State -1, Tenha Fujin Zan Max]
type = ChangeState
value = 3500
triggerall = command = "tenhaL3"
triggerall = power >= 3000
triggerall = statetype != A
trigger1 = ctrl
trigger2 = stateno = 200 || stateno = 400 || stateno = 230 && movecontact
trigger3 = (stateno = 240 && anim = 241) || (stateno = 250 && anim = 251) && movecontact
trigger4 = stateno = 430 || stateno = 440 && MoveContact
trigger5 = (stateno = 210 && anim = 211) || stateno = 410 || stateno = 420 || (stateno = 240) && movecontact
trigger6 = stateno = [1000,2999] && movecontact
;------------------------------------------------------------------------
;Tenha Dankuu Retsu Zan Max
[State -1, Tenha Dankuu Retsu Zan Max]
type = ChangeState
value = 3520
triggerall = command = "dankuuL3"
triggerall = power >= 3000
triggerall = statetype != A
trigger1 = ctrl
trigger2 = stateno = 200 || stateno = 400 || stateno = 230 && movecontact
trigger3 = (stateno = 240 && anim = 241) || (stateno = 250 && anim = 251) && movecontact
trigger4 = stateno = 430 || stateno = 440 && MoveContact
trigger5 = (stateno = 210 && anim = 211) || stateno = 410 || stateno = 420 || (stateno = 240) && movecontact
trigger6 = stateno = [1000,2999] && movecontact
