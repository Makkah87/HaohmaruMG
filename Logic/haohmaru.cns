;		   Haohmaru v2.0a Beta by Master Gouken
;======================================================================
;                            Variable Table		
;======================================================================
;			Var(1) : Intro Decider
;			Var(2) : Win Pose Decider
;			Var(3) : Hit Voice Randomizer
;			 Var(4) : -------
;			Var(5) : Throw Turn
;			Var(6) : ----
;			Var(7) : Juggle Addition
;			Var(8) : Senpuu in play
;			Var(9) : Parry Variable
;			Var(12): Long Jump Stuff
;			FVar(12): Damage Dampener
;======================================================================
[Data]
life = 972                ;Amount of life to start with
attack = 100              ;Amount of attack power to start with
defence = 100             ;Amount of defensive power to start with
fall.defence_up = 50      ;Amount to raise defence by on fall
liedown.time = 20         ;How long Haohmaru lies on the ground
airjuggle = 17            ;Number of juggle points
sparkno = 3               ;Default spark number
guard.sparkno = s1105     ;Default spark number
KO.echo = 0               ;Whether there should be an echo upon death
volumescale = 100         ;Pretty much self explanitory
hitsound.channel = 6	  ;Default channel for hit sounds
guardsound.channel = 6
IntPersistIndex = 60      ;Variables with this index and above will not 
FloatPersistIndex = 40    ;have their values reset to 0 between rounds
;====================================================================

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 20     ;Player width (back, ground)
ground.front = 20    ;Player width (front, ground)
air.back = 16        ;Player width (back, air)
air.front = 16       ;Player width (front, air)
height = 75          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 5, -77   ;Approximate position of head
mid.pos = -5, -46   ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.9           ;Walk forward
walk.back = -2.4          ;Walk backward
run.fwd  = 5.7, 0         ;Run forward (x, y)
run.back = -4.5,-3.8      ;Hop backward (x, y)
jump.neu = 0,-11.33	  ;Neutral jumping velocity (x, y)
jump.back = -3.4,-11.33     ;Jump back Speed (x, y)
jump.fwd = 3.4,-11.33       ;Jump forward Speed (x, y)
runjump.back = -4.88,-11.33 ;Running jump speeds (opt)
runjump.fwd = 4.88,-11.33     ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -4.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.
air.gethit.groundlevel = 25           ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -20 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 10   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -1  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = .6    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 15      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0, 20            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = .4               ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = 12          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .05         ;If the player's speed drops below this threshold while lying down, stop his movement **MUGEN 1.0**


[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 32  ;Minimum distance from ground before you can air jump (opt)
yaccel = 0.6;.6        ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

[Quotes]
victory1 = "Air-bending slice!"
victory2 = "I expected more of a challenge."
victory3 = "Let's go again! This time I'll tie one hand behind my back."
victory4 = "You should learn to dodge."
victory5 = "Run along now before I split you in two."
victory6 = "You're good, but I'm much better!"
victory7 = "A rematch? You're not worth my time..."
victory8 = "Next time I won't hold back."
victory9 = "Maybe you should try being a farmer."
;----------------------------------------------------------------------
; Lose by Time Over
; ---------------------------------------------------------------------
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;----------------------------------------------------------------------
; Win state decider
;----------------------------------------------------------------------
[Statedef 180]
type = S

[State 180, ScoreAdd]
type = scoreadd
trigger1 = !time
value = (life*50)+ifelse(winhyper, 30000,ifelse(winspecial,10000,1000))

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = ifelse(random < 500,182,181)

;----------------------------------------------------------------------
; Win pose 1 - Sword Toss
;----------------------------------------------------------------------
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 191, 2]
type = AssertSpecial
trigger1 = Time < 190
flag = roundnotover

[State 191, Snd 1]
type = PlaySnd
trigger1 = AnimElem = 3
value = 180,0
volumescale = 100

[State 191, Snd 2]
type = PlaySnd
trigger1 = AnimElem = 17
value = 180,3
volumescale = 100

[State 191, Snd 3]
type = PlaySnd
trigger1 = AnimElem = 19
value = 180,1
volumescale = 100

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;----------------------------------------------------------------------
; Win pose 1 - Sword Sheath
;----------------------------------------------------------------------
[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 191, 2]
type = AssertSpecial
trigger1 = Time < 190
flag = roundnotover

[State 191, Snd 1]
type = PlaySnd
trigger1 = AnimElem = 4
value = 210,2
volumescale = 100

[State 191, Snd 2]
type = PlaySnd
trigger1 = AnimElem = 25
value = 180,3
volumescale = 100

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;----------------------------------------------------------------------
; Intro state decider
;----------------------------------------------------------------------
[Statedef 191]
type = S

[State 191, Varset]
type = varset
trigger1 = time = 0
v = 1
value = ifelse(random < 500,1,2)

[State 191, Varset]
type = varset
triggerall = time = 0
trigger1 = enemy, name = "Shin Gouki"
trigger2 = enemy, authorname = "Master Gouken" && enemy, name = "ZXAkuma"
trigger3 = enemy, name = "Orochi Iori"
trigger4 = enemy, authorname = "Reu" && enemy, name = "Evil Ken"
trigger5 = enemy, name = "Evil Ryu"
trigger6 = enemy, name = "EvilRyu"
trigger7 = enemy, name = "Gouki"
trigger8 = enemy, name = "Akuma"
trigger9 = enemy, name = "cvsgouki"
trigger10 = enemy, name = "cvsakuma"
trigger11 = enemy, name = "demitri"
trigger12 = enemy, authorname = "Big Eli King" && enemy, name = "Dark Chun Li"
trigger13 = enemy, authorname = "Sumi" && enemy, name = "Destrudo Ryu"
trigger14 = enemy, name = "sf3gouki"
trigger15 = enemy, authorname = "Z Sabre User" && enemy, name = "Cvshaohmaru" && enemy, palno = 7
trigger16 = enemy, authorname = "Master Gouken" && enemy, name = "AkumaMG"
v = 1
value = 3

[State 191, 1]
type = ChangeState
trigger1 = Time = 0 && var(1) = 1
value = 192

[State 191, 1]
type = ChangeState
trigger1 = Time = 0 && var(1) = 2
value = 194

[State 191, Demon]
type = ChangeState
trigger1 = Time = 0 && var(1) = 3
value = 193

;--------------------------------------------------------------------
; Introduction -Lets have a fair fight
;--------------------------------------------------------------------
[Statedef 192]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 192, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 192, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 192, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

[State 192, Hawk_Tua]
type = PlaySnd
trigger1 = AnimElem = 7
value = 190,1
volumescale = 100

[State 192, Snd 2]
type = PlaySnd
trigger1 = AnimElem = 11
value = 190,0
volumescale = 100

;--------------------------------------------------------------------
; Introduction -Well, let's write your epitaph
;--------------------------------------------------------------------
