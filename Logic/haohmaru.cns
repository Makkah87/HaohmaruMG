trigger2 = gethitvar(isbound)
trigger3 = prevstateno = [1002,1003]
trigger4 = prevstateno = [900,999]
time = 0
add = 0,0,0
ignorehitpause = 1

[State -2, Stop Super BGeffects]
type = bgpalfx
trigger1 = MoveType = H & Time = 0
trigger1 = prevmovetype = A
add = 0,0,0
time = 0

[State -2, TripMemReset]
