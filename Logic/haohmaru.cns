ctrl = 0
anim = 191
velset = 0,0

[State 192, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 192, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

[State 192, Snd 1]
type = PlaySnd
trigger1 = Time = 3
value = 190,3
volumescale = 100

