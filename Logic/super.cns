;===================================
;Large Power Extend
;===================================
[Statedef 4000]
type    = S
movetype= A
physics = S
juggle  = 4
velset = 0,0
anim = 6000
ctrl = 0
sprpriority = 5

[State 4000, Zoom]
type = zoom
trigger1 = time < 30
scale = 1.2
lag = 0.8
pos = root,pos x, root,pos y
stagebound = 1
camerabound = 0
ignorehitpause = 1

[State 4000, Zoom]
type = zoom
trigger1 = time >= 30
scale = 1.0
lag = 0.8
pos = 0,0
stagebound = 1
camerabound = 0
ignorehitpause = 1

[State 4000, Super Scale Factor]
type = ParentMapAdd
trigger1 = !time
map = "scale_factor"
value = ifelse(root,prevstateno = [3000,3999],1,2)

[State 4000, Super Scale Factor]
type = ParentMapSet
trigger1 = !time
map = "scale_factor_timer"
value = 30

[State 4000, var]
type = varadd
trigger1 = 1
v = 1
value = 2
supermovetime = 9999

[State 4000, Blue_BG]
type = bgpalfx
trigger1 = time = 0
add = 0,0,200
time = 40
sinadd = -255,-255,-255,90

[State 3200, Assert]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 1061, Grow]
type = angledraw
trigger1 = 1
value = 0
scale = ((var(1))*0.10),((var(1))*0.10)
supermovetime = 9999

[State 1061, Trans]
type = trans
trigger1 = 1
trans = add
;supermovetime = 9999

[State 1060, EpiCenter]
type = Helper
trigger1 = Time = 0;AnimElem = 2, 1
name = "super2"
postype = P1
pos = 0, 0 ;26,-55
ownpal = 1
stateno = 4001
id = 4001
supermovetime = 9999

[State 1060, Lv. 3 Effects]
type = Helper
triggerall = parent, stateno = (3020, 3999]
trigger1 = Time = 0;AnimElem = 2, 1
name = "fiyah"
postype = P1
pos = 0, 0 ;26,-55
ownpal = 1
stateno = 4003
id = 4003
supermovetime = 9999
size.xscale = 1
size.yscale = 1

[State 1060, ShockWaves]
type = Helper
trigger1 = time%5 = 1 && time <= 35
name = "wave"
postype = P1
pos = 0,0
ownpal = 1
stateno = 4002
id = 4002
supermovetime = 9999

[State 1062, fade]
type = palfx
trigger1 = time = 0
mul = 350,350,350
sinadd = -255,-255,-255,200
time = 40
supermovetime = 9999

[State 123, Destroy]
type = destroyself
trigger1 = time = 40
supermovetime = 9999
