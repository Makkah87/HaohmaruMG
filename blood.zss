[Statedef -3]
ignorehitpause{
if movehitvar(frame) = 1 && movehit && hitdefvar(sparkno) = 8017{


helper{id:8000;stateno:8000;pos:(hitdefvar(sparkx)),(hitdefvar(sparky))+pos y;postype:p2}
}
}


[statedef 8000]

if !time{
changeanim{value:-2}
}

#Normal Attacks
if root,hitdefattr = SCA, NA && (!time || (time%3=1 && time < 6)){
explod{anim:8001;pos:(hitdefvar(sparkx)),(hitdefvar(sparky)-p2, pos y);postype:p1;sprpriority:10;vel:0+random%5,-1;accel:0.4,0.9}

if p2,gethitvar(animtype)=2  && (!time || (time%3=1 && time < 4)){
explod{anim:8003;pos:(hitdefvar(sparkx)),(hitdefvar(sparky)-p2,pos y);postype:p1;sprpriority:10;vel:0,-4;accel:0.23,0.2;scale:0.5,0.5}
explod{anim:8002;pos:(hitdefvar(sparkx)),(hitdefvar(sparky)-p2,pos y);postype:p1;sprpriority:10;vel:2.3,-2;accel:0.23,0.2;scale:0.5,0.5}
}

}

#Special Attacks
if root,hitdefattr = SCA, SA && !time{
explod{anim:8002;pos:(hitdefvar(sparkx)),((hitdefvar(sparky))-p2,pos y)-45;postype:p1;sprpriority:10;vel:-2-random%2.33,-1;accel:-0.5,0.3;scale:0.5,0.5}
explod{anim:8002;pos:(hitdefvar(sparkx)),(hitdefvar(sparky))-p2,pos y;postype:p1;sprpriority:10;vel:2-random%2.33,-2.3;accel:0,0.3;scale:0.7,0.7}
explod{anim:8003;pos:(hitdefvar(sparkx)),(hitdefvar(sparky))-p2,pos y;postype:p1;sprpriority:10;vel:0,-5.6;accel:0,0.42;scale:0.65,0.65}
}

#Super Attacks
if root,hitdefattr = SCA, HA && !time{
explod{anim:8003;pos:(hitdefvar(sparkx)),(hitdefvar(sparky))-p2,pos y;postype:p1;sprpriority:10;vel:1.3,-4;accel:0.23,0.2;scale:0.75,0.75}
}

if root, movetype != A{destroyself{}}